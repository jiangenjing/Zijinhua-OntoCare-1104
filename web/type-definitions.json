    {
      "id": "action:recordCheckResult",
      "kind": "ActionType",
      "name": "recordCheckResult",
      "label": "记录检查结果",
      "status": "implemented",
      "statusDetail": "已接入本地类型契约运行时：输入校验、适用性/任务范围校验、持久化对象与关联及审计；不执行外部售后。",
      "definition": {
        "ActionType": "recordCheckResult",
        "displayName": "记录检查结果",
        "description": "追加用户明确报告的结果，不直接确认根因或审批售后。",
        "parameters": {
          "task": {
            "type": "ObjectReference",
            "objectType": "ServiceTask"
          },
          "step": {
            "type": "ObjectReference",
            "objectType": "CheckStep"
          },
          "result": {
            "type": "enum",
            "values": [
              "RESOLVED",
              "PERSISTS",
              "INCONCLUSIVE",
              "NOT_PERFORMED"
            ]
          },
          "statement": {
            "type": "string"
          }
        },
        "validation": [
          {
            "rule": "canHandleTask(currentIdentity, task)",
            "errorMessage": "没有处理该任务的权限"
          },
          {
            "rule": "isApplicableCheck(step, task)",
            "errorMessage": "检查不适用于当前产品上下文"
          },
          {
            "rule": "hasExplicitReportedResult(statement, result)",
            "errorMessage": "需要明确的检查结果"
          }
        ],
        "rules": [
          {
            "type": "createObject",
            "objectType": "CheckObservation",
            "bind": "observation",
            "values": {
              "observationId": "serverGeneratedId()",
              "result": "$result",
              "verificationStatus": "REPORTED",
              "reportedAt": "serverTime()",
              "procedureRevision": "$step.revision"
            }
          },
          {
            "type": "createLink",
            "linkType": "HAS_OBSERVATION",
            "from": "$task",
            "to": "$observation"
          }
        ],
        "permissions": {
          "roles": [
            "CustomerServiceAgent",
            "SupportAgent",
            "CustomerServiceSupervisor"
          ],
          "purpose": "customer-service-review",
          "scope": "server_identity_and_owned_task"
        },
        "audit": true,
        "idempotency": "requestId",
        "implementation": "ontocare.type_contracts.execute（白名单处理器，不解释执行JSON表达式）"
      },
      "references": [
        "object:ServiceTask",
        "object:CheckObservation",
        "object:CheckStep",
        "link:HAS_OBSERVATION"
      ],
      "examples": [],
      "source": [
        "ontocare/type_contracts.py"
      ],
      "traceTools": [],
      "executionUrl": "/ontology/contracts#recordCheckResult"
    },
    {
      "id": "action:submitManualReview",
      "kind": "ActionType",
      "name": "submitManualReview",
      "label": "提交人工复核申请",
      "status": "implemented",
      "statusDetail": "已接入本地类型契约运行时：输入校验、适用性/任务范围校验、持久化对象与关联及审计；不执行外部售后。",
      "definition": {
        "ActionType": "submitManualReview",
        "displayName": "提交人工复核申请",
        "description": "登记复核请求，不批准退款或换货。",
        "parameters": {
          "task": {
            "type": "ObjectReference",
            "objectType": "ServiceTask"
          },
          "reason": {
            "type": "string"
          },
          "evidenceRefs": {
            "type": "array",
            "items": "EvidenceReference"
          }
        },
        "validation": [
          {
            "rule": "canHandleTask(currentIdentity, task)",
            "errorMessage": "没有处理该任务的权限"
          },
          {
            "rule": "hasValidReason(reason)",
            "errorMessage": "缺少复核原因"
          },
          {
            "rule": "allEvidenceAccessible(currentIdentity, evidenceRefs)",
            "errorMessage": "证据不可访问或不属于此任务"
          },
          {
            "rule": "noActiveDuplicateReview(task)",
            "errorMessage": "已有有效复核申请，返回原编号"
          }
        ],
        "rules": [
          {
            "type": "createObject",
            "objectType": "ServiceRequest",
            "bind": "request",
            "values": {
              "requestId": "serverGeneratedId()",
              "kind": "MANUAL_REVIEW",
              "status": "SUBMITTED",
              "executionMode": "LOCAL_REVIEW",
              "submittedAt": "serverTime()"
            }
          },
          {
            "type": "createLink",
            "linkType": "REQUEST_HANDLES_TASK",
            "from": "$request",
            "to": "$task"
          }
        ],
        "permissions": {
          "roles": [
            "CustomerServiceAgent",
            "SupportAgent",
            "CustomerServiceSupervisor"
          ],
          "purpose": "customer-service-review",
          "scope": "server_identity_and_owned_task"
        },
        "audit": true,
        "idempotency": "requestId + activeReview(task)",
        "implementation": "ontocare.type_contracts.execute（白名单处理器，不解释执行JSON表达式）"
      },
      "references": [
        "object:ServiceTask",
        "object:ServiceRequest",
        "link:REQUEST_HANDLES_TASK"
      ],
      "examples": [],
      "source": [
        "ontocare/type_contracts.py"
      ],
      "traceTools": [],
      "executionUrl": "/ontology/contracts#submitManualReview"
    },
